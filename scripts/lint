#!/usr/bin/env bash

set -e

cd -- "$(dirname -- "$0")/.."

# CI=true → phpstan.dist.neon (parallel, fast)
# unset    → phpstan.local.neon (1 process; stable on Docker bind mounts)
if [ -n "${CI:-}" ]; then
  CONFIG=phpstan.dist.neon
else
  CONFIG=phpstan.local.neon
fi

echo "==> Running PHPStan (config: ${CONFIG})"
exec -- ./vendor/bin/phpstan analyse \
  --configuration="$CONFIG" \
  --memory-limit=12G
